{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "next lint",
    "start": "next start",
    "android:build": "CAPACITOR_BUILD=true npm run build",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "android:build:apk": "cd android && ./gradlew assembleDebug && cd ..",
    "android:build:release": "cd android && ./gradlew assembleRelease && cd ..",
    "db:setup": "node scripts/setup-tencent-cloud-db.js",
    "db:setup-cloudbase": "node scripts/setup-cloudbase-db.js",
    "db:setup-supabase": "node scripts/setup-supabase-db.js",
    "db:migrate": "node scripts/migrate-to-tencent-cloud.js",
    "db:test": "node scripts/test-database.js",
    "db:test-switch": "node scripts/test-database-switch.js",
    "auth:test-cloudbase": "node scripts/test-cloudbase-auth.js",
    "docker:build": "docker build -t mvp22:latest .",
    "docker:run": "docker run -p 3000:3000 --env-file .env.local mvp22:latest",
    "docker:push": "echo '请先登录腾讯云镜像仓库: docker login ccr.ccs.tencentyun.com'",
    "tencent:build": "docker build --platform linux/amd64 -t mvp22-tencent .",
    "tencent:deploy": "echo '使用腾讯云控制台或 CLI 部署容器'",
    "cloudbase:check": "node check-cloudbase-config.js",
    "cloudbase:check-deploy": "node scripts/check-cloudbase-deployment.js",
    "wechat:check": "node scripts/check-wechat-config.js",
    "wechat:test": "node scripts/test-wechat-login.js",
    "auth:test": "node scripts/test-auth-state.js",
    "env:prod-test": "node scripts/test-production-env.js",
    "wechat:check-prod": "echo '在生产环境浏览器控制台运行: fetch(\"/api/wechat/config\").then(r=>r.json()).then(d=>console.log(JSON.stringify(d,null,2)))'",
    "env:check": "node check-env-content.js",
    "env:validate": "node check-env.js",
    "payment:check": "node check-payment-env.js",
    "deploy:prepare": "npm run env:check && npm run cloudbase:check && npm run payment:check",
    "deploy:build": "npm run deploy:prepare && npm run docker:build",
    "deploy:test": "npm run docker:run",
    "health": "curl -f http://localhost:3000/api/health || exit 1",
    "test:all": "npm run env:validate && npm run cloudbase:check && npm run payment:check && npm run health",
    "cloudbase:login": "cloudbase login",
    "cloudbase:deploy": "CLOUDBASE_BUILD=true cloudbase hosting:deploy",
    "cloudbase:functions:deploy": "cloudbase functions:deploy",
    "cloudbase:functions:deploy-email": "cloudbase functions:deploy sendEmailVerification",
    "cloudbase:env:list": "cloudbase env:list",
    "cloudbase:hosting:list": "cloudbase hosting:list",
    "cloudbase:build": "node -e \"process.env.CLOUDBASE_BUILD='true'; require('child_process').execSync('npm run build', {stdio: 'inherit'})\"",
    "cloudbase:full-deploy": "npm run cloudbase:functions:deploy-email && npm run cloudbase:deploy",
    "cloudbase:auto-deploy": "node deploy-cloudbase.js",
    "cloudbase:dry-run": "node deploy-cloudbase.js --dry-run",
    "cloudbase:dev": "node -e \"process.env.CLOUDBASE_BUILD='true'; require('child_process').execSync('npm run dev', {stdio: 'inherit'})\"",
    "cloudbase:test": "node -e \"process.env.CLOUDBASE_BUILD='true'; require('child_process').execSync('npm run test:all', {stdio: 'inherit'})\"",
    "config:cn": "cp .env.cloudbase.example .env.local",
    "config:intl": "cp .env.supabase.example .env.local",
    "config:test": "node scripts/test-database-switch.js"
  },
